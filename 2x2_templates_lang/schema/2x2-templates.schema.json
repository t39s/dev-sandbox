{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/2x2-templates-v1.schema.json",
  "title": "2x2 Templates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "id",
    "revision",
    "title",
    "templates",
    "levels"
  ],
  "properties": {
    "format": {
      "const": "2x2-templates"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/level"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "min",
            "max"
          ],
          "not": {
            "required": [
              "values"
            ]
          }
        },
        {
          "required": [
            "values"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ]
          }
        }
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "max": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "variables": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/domain"
          }
        },
        "derived": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          }
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "constraints": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "prompt": {
          "type": "string",
          "maxLength": 500
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "oneOf": [
        {
          "required": [
            "expression"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "prompt"
                ]
              },
              {
                "required": [
                  "answer"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "prompt",
            "answer"
          ],
          "not": {
            "required": [
              "expression"
            ]
          }
        }
      ]
    },
    "levelItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "count"
      ],
      "properties": {
        "templateId": {
          "$ref": "#/$defs/id"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "maxErrors",
        "maxSeconds",
        "items",
        "shuffle"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "maxErrors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/levelItem"
          }
        },
        "shuffle": {
          "type": "boolean"
        }
      }
    }
  }
}